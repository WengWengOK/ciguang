# ===== 词光项目环境变量配置 =====
# 复制本文件为 .env 并填入真实值后，docker-compose 会自动读取

# ===== JWT 配置 =====
# 生产环境务必修改为随机字符串（建议32位以上）
JWT_SECRET=please-change-this-to-a-random-secret-string

# ===== AI 服务 API Key =====
# DashScope（通义千问）- 用于文本生成和多模态分析
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# DeepSeek - 备选文本生成服务
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ===== 前端访问地址（CORS 配置）=====
# 通过 docker-compose 启动时，前端默认运行在 8080 端口
FRONTEND_URL=http://localhost:8080
