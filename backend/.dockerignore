# 依赖目录（容器内重新安装）
node_modules

# 日志文件
npm-debug.log
npm-debug.log.*
yarn-debug.log*
yarn-error.log*

# 环境变量（敏感信息不进入镜像）
.env
.env.local
.env.*.local

# 数据库文件（由 volume 持久化，不打入镜像）
*.db
*.db-journal
*.sqlite
*.sqlite3

# 版本控制
.git
.gitignore

# IDE / 编辑器配置
.vscode
.idea
*.swp
*.swo
.DS_Store

# 文档与测试
*.md
coverage
.nyc_output

# Docker 自身文件
Dockerfile
.dockerignore
docker-compose*.yml
